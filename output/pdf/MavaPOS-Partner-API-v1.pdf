  "components": {
    "securitySchemes": {
      "PartnerKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "mava_live_... or mava_test_..."
      },
      "ClientKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Client-Key",
        "description": "Client Key pasangan Bearer token, dibuat/diganti di Pengaturan. Kedua header wajib dikirim."
      }
    },
    "schemas": {
      "Meta": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string",
            "enum": [
              "Asia/Makassar"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "IDR"
            ]
          },
          "sandbox": {
            "type": "boolean"
          },
          "page": {
            "type": "integer",
            "format": "int64"
          },
          "per_page": {
            "type": "integer",
            "format": "int64"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "last_page": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Page": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "format": "int64"
          },
          "per_page": {
            "type": "integer",
            "format": "int64"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "last_page": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "Outlet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "VariantSnapshot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "attributes": {
            "nullable": true,
            "description": "Atribut varian saat transaksi: objek/array JSON, atau null."
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "sku": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "integer",
            "format": "int64",
            "description": "Nominal rupiah bulat (IDR)."
          },
          "category": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64"
              },
              "name": {
                "type": "string"
              }
            },
            "nullable": true
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "format": "int64"
                },
                "name": {
                  "type": "string"
                },
                "sku": {
                  "type": "string",
                  "nullable": true
                },
                "price": {
                  "type": "integer",
                  "format": "int64",
                  "description": "Nominal rupiah bulat (IDR)."
                },
                "price_adjustment": {
                  "type": "integer",
                  "format": "int64",
                  "description": "Nominal rupiah bulat (IDR)."
                },
                "attributes": {
                  "nullable": true,
                  "description": "Atribut varian: objek/array JSON, atau null."
                },
                "active": {
                  "type": "boolean"
                }
              }
            }
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Item": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "product_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },

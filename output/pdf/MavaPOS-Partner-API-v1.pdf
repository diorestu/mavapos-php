    "/sales-summary": {
      "get": {
        "operationId": "salesSummary",
        "summary": "Total penjualan dan penjualan kotor per produk",
        "parameters": [
          {
            "name": "outlet_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "ID outlet milik merchant."
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Waktu mulai penjualan, termasuk hasil. Wajib zona waktu dan detik, tanpa pecahan detik."
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Waktu akhir tidak termasuk hasil. Harus setelah from, maksimal 31 hari."
          },
          {
            "name": "updated_since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Ambil transaksi/refund yang berubah sejak waktu ini. Rentang fromâ€“to tetap berlaku."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "completed",
                "voided",
                "partially_refunded",
                "refunded",
                "pending"
              ]
            },
            "description": ""
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1

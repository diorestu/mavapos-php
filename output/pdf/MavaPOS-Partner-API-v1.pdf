stream
{
  "openapi": "3.0.3",
  "info": {
    "title": "MavaPOS Partner API",
    "version": "1.1.0",
    "description": "API baca data outlet, produk, transaksi dan ringkasan penjualan satu merchant. Semua request wajib memakai Bearer token dan X-Client-Key pasangannya. Batas 60 request/menit/key; nominal rupiah bulat dan waktu WITA. Rentang transaksi maksimal 31 hari. Lihat partner-api.md untuk contoh request dan webhook."
  },
  "servers": [
    {
      "url": "https://mavapos.id/api/partner/v1",
      "description": "Produksi MavaPOS."
    },
    {
      "url": "https://mavapos.id/api/partner/sandbox/v1",
      "description": "Sandbox MavaPOS dengan data contoh. Gunakan pasangan key sandbox."
    }
  ],
  "security": [
    {
      "PartnerKey": [],
      "ClientKey": []
    }
  ],
  "paths": {
    "/outlets": {
      "get": {
        "operationId": "listOutlets",
        "summary": "Daftar outlet, termasuk yang nonaktif",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            },
            "description": ""
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": ""
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil.",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                },
                "description": "Batas request per menit per key."
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutletPage"
                }
              }
            }
          },
          "401": {
            "description": "Bearer atau Client Key tidak valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Mode key tidak cocok atau fitur hanya untuk sandbox.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Data tidak ditemukan atau bukan milik merchant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Parameter request tidak valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Batas request tercapai. Ikuti Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                },
                "description": "Jumlah detik sebelum mencoba lagi."
              },
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                },
                "description": "Batas request per menit per key."
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "Daftar produk, kategori dan varian",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            },
            "description": ""
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": ""
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil.",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                },
                "description": "Batas request per menit per key."
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPage"
                }
              }
            }
          },
          "401": {
            "description": "Bearer atau Client Key tidak valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Mode key tidak cocok atau fitur hanya untuk sandbox.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Data tidak ditemukan atau bukan milik merchant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Parameter request tidak valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Batas request tercapai. Ikuti Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                },
                "description": "Jumlah detik sebelum mencoba lagi."
              },
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                },
                "description": "Batas request per menit per key."
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            }
          }
        }
      }
    },
    "/transactions": {
      "get": {
        "operationId": "listTransactions",
        "summary": "Daftar transaksi, termasuk pending, void dan refund",
        "parameters": [
          {
            "name": "outlet_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "ID outlet milik merchant."
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Waktu mulai penjualan, termasuk hasil. Wajib zona waktu dan detik, tanpa pecahan detik."
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Waktu akhir tidak termasuk hasil. Harus setelah from, maksimal 31 hari."
          },
          {
            "name": "updated_since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Ambil transaksi/refund yang berubah sejak waktu ini. Rentang fromâ€“to tetap berlaku."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "completed",
                "voided",
                "partially_refunded",
                "refunded",
                "pending"
              ]
            },
            "description": ""
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            },
            "description": ""
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": ""
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil.",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                },
                "description": "Batas request per menit per key."
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionPage"
                }
              }
            }
          },
          "401": {
            "description": "Bearer atau Client Key tidak valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Mode key tidak cocok atau fitur hanya untuk sandbox.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
